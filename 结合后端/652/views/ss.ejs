<div>
    <ul class="itemMain">
        <h1><%= perfume.perfumeName %></h1>
        <div class="imgborder1">
            <img src="" class="noxx" onerror="this.onerror=null;this.src='/static/picture/image/六神花露水.webp';"> <!-- 假设图片URL存储在perfume.image字段 -->
        </div>
        <ul class="item_info">
            <li>
                品牌:
            <a><%= perfume.brand %></a>
                <br>
                排名：
                <a><%= perfume.Rank%></a>
                <br>
                香调:
                <a><%= perfume.xiangdiao %></a>
                <br>
                前调:
                <% perfume.qiandiao.split(' ').forEach(function(note) { %>
                    <a><%= note %></a>
                <% }); %>
                <br>
                中调:
                <% perfume.zhongdiao.split(' ').forEach(function(note) { %>
                    <a><%= note %></a>
                <% }); %>
                <br>
                后调:
                <% perfume.houdiao.split(' ').forEach(function(note) { %>
                    <a><%= note %></a>
                <% }); %>
                <br>
                调香师:
                <a><%= perfume.perfumer %></a>
                <br>
            </li>
        </ul>
        <ul class="item_score">
            <li>
                <div class="score-and-stars">
                    <div class="score">
                        <%= perfume.score ? perfume.score + '分' : '暂无' %>
                    </div>
                    <div class="stars">
                       <% 
                         var fullStars = Math.floor(perfume.score / 2); 
                         var halfStar = perfume.score % 2 >= 1.5; 
                         var partialStar = perfume.score % 2 >= 1 && perfume.score % 2 < 1.5; 
                         var starSlots = 5; 
                       %>
                       <% for(var i = 0; i < fullStars; i++) { %>
                          <img src="/static/image/4.png" alt="Star" class="star"> <!-- 满星 -->
                        <% } %>
                        <% if(partialStar) { %>
                          <img src="/static/image/3.png" alt="Star" class="star"> <!-- 1到1.5分的星星 -->
                        <% } %>
                        <% if(halfStar) { %>
                          <img src="/static/image/2.png" alt="Star" class="star"> <!-- 0到1分的星星 -->
                        <% } %>
                        <% for(var i = fullStars + (partialStar ? 1 : 0) + (halfStar ? 1 : 0); i < starSlots; i++) { %>
                          <img src="/static/image/1.png" alt="Star" class="star"> <!-- 空星填充 -->
                        <% } %>
                     </div>
                    </div>
                    
                    <div class="shouchang-button">
                        <img class="heart" src="/static/image/start.webp" style="width: 30px;"></img>
                      </div>
            </li>
          </ul>
        <li class="ajaxodor">
            <br>
            <h5>最明显的气味</h5>
            <div class="odor-lists" style="display: block">
                <% if (perfume.qiwei) { 
                  
                    var odors = perfume.qiwei.replace(/\([^)]+\)/g, '').split(/\s+/);
                    odors.forEach(function(odorName) {
                     odorName = odorName.trim();
                        if (odorName) {
                %>
                            <a class="addodor ng-scope" ng-click="postodor()">
                                <!-- 动态生成气味对应的图片路径 -->
                                <img src="/static/image/<%= odorName %>.webp" onerror="this.onerror=null;this.src='/static/image/default.webp';">
                                <br>
                                <p>
                                    <span class="ng-binding"><%= odorName %></span>
                                </p>
                            </a>
                <% 
                        }
                    });
                } %>
            </div>
        </li>
        
    </ul>
    
