<div class="contents">
   <h1 style="color:pink">所有品牌:</h1>
   <div class="xian"></div>
   <div class="txsl_left">
    <h2>首字母:
    <!-- 生成字母链接 -->
    <% for(const letter in sortedPerfumers) { %>
        <a href="#<%= letter %>"><%= letter %></a>
    <% } %>
    </h2>
    <% for(const letter in sortedPerfumers) { %>
    <dl>
        <a id="<%= letter %>" name="<%= letter %>" class="anchor-target">
            <dt><%= letter %></dt>
        </a>
        <% sortedPerfumers[letter].forEach(perfumer => { %>
            <dd>
               <a href="/brand/brandDetail?name=<%= encodeURIComponent(perfumer.EnglishName) %>"><%= perfumer.EnglishName %></a>
            </dd>
        <% }) %>
    </dl>
    <% } %>
</div>
