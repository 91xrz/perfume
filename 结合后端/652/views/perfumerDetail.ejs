<!DOCTYPE html>
<html lang="en">
<head>
   <!--<< Required meta tags >>-->
   <meta charset="UTF-8">
   <meta http-equiv="X-UA-Compatible" content="IE=edge">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <!--<< Title >>-->
  <title>寻香悦己-调香师</title>
   <!--<< Favcion >>-->
   
   <!--<< Bootstrap min.css >>-->
   <link rel="stylesheet" href=" /static/css/bootstrap.min.css">
   <!--<< Aos animation css >>-->
   <link rel="stylesheet" href=" /static/css/aos.css">
   <!--<< Main.css >>-->
   <link rel="stylesheet" href=" /static/css/main.css">
   <link rel="stylesheet" href=" /static/css/xiangdiao.css">
   <style>.content {
    min-height: 80vh; /* 使内容至少与视口一样高 */
}

.star {
  width: 20px; /* 设置图片宽度为20px */
  height: auto; /* 高度自动，保持图片比例 */
}
.score-and-stars {
  display: flex; /* 启用Flexbox */
  align-items: center; /* 垂直居中 */
  justify-content: flex-start; /* 从行的开始处对齐项目 */
  gap: 10px; /* 设置分数和星星之间的间距 */
}

</style>

</head>
<body>

    <%- include('./partials/header') %>
   <!--<< Header v-1 >>-->
   <div class="container pt-120 pb-120">
      <div class="row g-4 justify-content-center">
         <div class="col-lg-8">
            <div class="breadcrumnd__wrap text-center">
               <h1>
                  调香师
               </h1>
               <ul class="breakcrumnd__cont justify-content-center">
                  <li>
                     <a href="/index.html">
                        Home 
                     </a>
                  </li>
                  <li class="white">
                     /  
                  </li>
                  <li class="base">
                     magic
                  </li>
               </ul>
            </div>
         </div>
      </div>
   </div>
</section>
<div class="content ng-scop" ng-controller="NtLiKeCtrl">
    <div>
        <img src="/static/image/perfumer/<%= perfumer.perfumer1 %>.png" style="width:60%;height:500px;display:block;margin: auto;" onerror='imgcdnfallback(this," /static/image/果香调.webp")'>
        <div class='covertxt'><%= perfumer.perfumer1 %></div>
        <div class='fragrance clearfloat'>
     </div>
     <div class="desc">
         <p class="x"><%= perfumer.perfumer1 %></p>
         <p class="x"><%= perfumer.jianjie %></p>
     </div>
     <div style="font-size:18px;color:rgb(80, 122, 174)">该调香师香水推荐：</div>
     <div style="height:10px;margin:0;position:relative;clear:both;border-bottom: 3px solid #eee;"></div>
     <div class="items" id="items" compile="items">
        <% if (perfumes && perfumes.length > 0) { %>
            <% perfumes.forEach(function(perfume) { %>
                <div class="item ng-scope">
                  <a href="/perfumeDetail/<%= perfume.id %>" target="_blank" class="imgborder">
                     <img src="/static/picture/perfume/<%= perfume.id %>.png" class="noxx" onerror="this.onerror=null;this.src='/static/picture/image/六神花露水.webp';">
                    </a>
                    <div class="detail">
                        <a href="/perfumeDetail/<%= perfume.id %>" target="_blank">
                            <h2><%= perfume.perfumeName %></h2>
                        </a>
                        <div class="score-and-stars">
                        <div class="score">
                            <%= perfume.score ? perfume.score + '分' : '暂无' %>
                        </div>
                        <div class="stars">
                           <% 
                             var fullStars = Math.floor(perfume.score / 2); 
                             var halfStar = perfume.score % 2 >= 1.5; 
                             var partialStar = perfume.score % 2 >= 1 && perfume.score % 2 < 1.5; 
                             var starSlots = 5; 
                           %>
                           <% for(var i = 0; i < fullStars; i++) { %>
                              <img src="/static/image/4.png" alt="Star" class="star"> <!-- 满星 -->
                            <% } %>
                            <% if(partialStar) { %>
                              <img src="/static/image/3.png" alt="Star" class="star"> <!-- 1到1.5分的星星 -->
                            <% } %>
                            <% if(halfStar) { %>
                              <img src="/static/image/2.png" alt="Star" class="star"> <!-- 0到1分的星星 -->
                            <% } %>
                            <% for(var i = fullStars + (partialStar ? 1 : 0) + (halfStar ? 1 : 0); i < starSlots; i++) { %>
                              <img src="/static/image/1.png" alt="Star" class="star"> <!-- 空星填充 -->
                            <% } %>
                         </div>
                        </div>
                        <div class="info">
                            前调：<%=perfume.qiandiao %>
                            <br>
                            中调：<%=perfume.zhongdiao %>
                            <br>
                            后调：<%=perfume.houdiao %>
                        </div>
                    </div>
                    <br><br> <br><br>
                    <div class="shouchang-button" data-perfume-id="<%= perfume.id %>">
                     <img class="heart" src="/static/image/start.webp" style="width: 30px;">
                   </div>
                </div>
            <% }); %>
        <% } else { %>
            <p>No perfumes found for this perfumer.</p>
        <% } %>
    </div>
    </div>
</div>
<div class="subside__barmenu sub__contact">
    <div class="remove__click d-flex justify-content-center align-items-center">
       <i class="bi bi-x-lg"></i>
    </div>
    <div>
       <img src="static/picture/logo.png" alt="img" style="height: 50px;width: 100px;">
    </div>
    <div class="sub__contact__wrapper d-grid">
       <p style="font-size: x-large;"><strong>欢迎您！</strong><img src="static/image/life.webp" style="width: 50%;height:30px;"></p>
       <a href="index.html" class="side-logo">
          <img src="/static/picture/头像.webp" alt="img" class="side-logo1">
       </a>
       <ul>
          <li>
             昵称：<input type="text" class="passwordInput" readonly>
          </li>
       </ul>
    </div>
 
    <a href="#" id="profileLink" class="d-flex justify-content-center fw-500 cmn--btn align-items-center gap-2">
        <span>
            <i class="bi bi-chevron-right"></i>             
        </span>
        <span class="get__text">
          个人信息
        </span>
    </a>
       <a href="index.html" class="d-flex justify-content-center fw-500 cmn--btn align-items-center gap-2 logout-button">
          <span>
             <i class="bi bi-chevron-right"></i>             
          </span>
          <span class="get__text">
             退出登录
          </span>
       </a>
 </div> 
<div class="progress-wrap">
    <svg class="progress-circle svg-content" width="100%" height="100%" viewbox="-1 -1 102 102">
       <path fill="#c9f31d" d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98"></path>
    </svg>
    <i class="bi bi-arrow-90deg-up title topping"></i>
 </div>
 <!--<< Scroll To Top >>-->

 <!--<< Jquery Latest >>-->
 <%- include('./partials/jss') %>
 <script>
   document.addEventListener('DOMContentLoaded', function() {
       // 检查并更新收藏状态
       checkAndUpdateFavorites();
   
       document.querySelectorAll('.shouchang-button').forEach(function(button) {
           button.addEventListener('click', function() {
               var img = this.querySelector('.heart');
               var perfumeId = this.getAttribute('data-perfume-id');
               var isFavorite = img.getAttribute('src') === '/static/image/start-icon.webp';
   
               // 检查登录状态
               fetch('/check-login')
                   .then(response => response.json())
                   .then(data => {
                       if (data.isLoggedIn) {
                           // 已登录，处理收藏逻辑
                           if (!isFavorite) {
                               img.src = '/static/image/start-icon.webp';
                               addFavorite(perfumeId);
                           } else {
                               img.src = '/static/image/start.webp';
                               removeFavorite(perfumeId);
                           }
                       } else {
                           // 未登录，跳转到 contact.html
                           window.location.href = '/contact.html';
                       }
                   });
           });
       });
   });
   
  
   </script>
   
 <!--<< Main.js >>-->
</body>
</html>