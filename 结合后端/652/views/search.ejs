   <script>
      document.addEventListener('DOMContentLoaded', function() {
          var searchInput = document.getElementById('searchInput');
          var searchLink = document.getElementById('searchLink');
      
          // 更新链接的函数
          function updateLink() {
              var query = searchInput.value; // 获取输入框的值
              searchLink.href = '/sousuo?query=' + encodeURIComponent(query); // 更新链接的href属性
          }
      
          // 执行搜索的函数
          function performSearch() {
              updateLink(); // 更新链接
              window.location.href = searchLink.href; // 跳转到更新后的链接
          }
      
          // 监听输入框的输入事件（可选，如果你想实时更新链接）
          searchInput.addEventListener('input', function() {
              updateLink();
          });
      
          // 监听输入框的keydown事件，检测Enter键
          searchInput.addEventListener('keydown', function(event) {
              if(event.keyCode === 13) { // 13是Enter键的键码
                  event.preventDefault(); // 阻止默认行为
                  performSearch(); // 执行搜索
              }
          });
      
          // 监听链接的点击事件
          searchLink.addEventListener('click', function(event) {
              event.preventDefault(); // 阻止链接的默认行为
              performSearch(); // 执行搜索
          });
      });
      </script>
      <script>
         // 将EJS变量`query`的值赋给JavaScript变量
         var searchQuery = "<%= query %>";
       </script>
       <script>document.getElementById('loadMoreButton').addEventListener('click', function() {
         const currentCount = document.querySelectorAll('.item.ng-scope').length;
         fetch(`/sousuo/loadMorePerfumes?offset=${currentCount}&limit=5&searchQuery=${encodeURIComponent(searchQuery)}`)
             .then(response => {
                 if (!response.ok) {
                     throw new Error(`服务器错误: ${response.statusText}`);
                 }
                 return response.json();
             })
             .then(data => {
                 const itemsContainer = document.getElementById('items');
                 data.forEach(perfume => {
                     // 评分和星级逻辑
                     const scoreText = perfume.score ? perfume.score + '分' : '暂无';
                     let starsHtml = '';
                     const fullStars = Math.floor(perfume.score / 2);
                     const halfStar = perfume.score % 2 >= 1.5;
                     const partialStar = perfume.score % 2 >= 1 && perfume.score % 2 < 1.5;
                     const emptyStars = 5 - fullStars - (partialStar ? 1 : 0) - (halfStar ? 1 : 0);
     
                     for (let i = 0; i < fullStars; i++) {
                         starsHtml += '<img src="/static/image/4.png" alt="Star" class="star">';
                     }
                     if (partialStar) {
                         starsHtml += '<img src="/static/image/3.png" alt="Star" class="star">';
                     }
                     if (halfStar) {
                         starsHtml += '<img src="/static/image/2.png" alt="Star" class="star">';
                     }
                     for (let i = 0; i < emptyStars; i++) {
                         starsHtml += '<img src="/static/image/1.png" alt="Star" class="star">';
                     }
     
                     // 构建每个香水的HTML结构
                     const itemHtml = `
                         <div class="item ng-scope">
                             <a href="" target="_blank" class="imgborder">
                                 <img src="/static/picture/perfume/${perfume.id}.png" class="noxx" onerror="this.onerror=null;this.src='/static/picture/image/六神花露水.webp';">
                             </a>
     
                             <div class="detail">
                                 <a href="/perfumeDetail/${perfume.id}" target="_blank">
                                     <h2>${perfume.perfumeName}</h2>
                                 </a>
                                 <div class="score-and-stars">
                                     <div class="score">
                                         ${scoreText}
                                     </div>
                                     <div class="stars">
                                         ${starsHtml}
                                     </div>
                                 </div>
     
                                 <div class="info">
                                     前调：${perfume.qiandiao}<br>
                                     中调：${perfume.zhongdiao}<br>
                                     后调：${perfume.houdiao}
                                 </div>
     
                                 <div class="shouchang-button" data-perfume-id="${perfume.id}">
                                     <img class="heart" src="/static/image/start.webp" style="width: 30px;">
                                 </div>
                             </div>
                         </div>`;
                     itemsContainer.innerHTML += itemHtml;
                 });
     
                 // 为新添加的收藏按钮绑定事件
                 document.querySelectorAll('.shouchang-button').forEach(function(button) {
                     button.removeEventListener('click', handleFavoriteClick); // 移除之前可能添加的事件监听器
                     button.addEventListener('click', handleFavoriteClick); // 重新添加事件监听器
                 });
                 checkAndUpdateFavorites(); 
             })
             .catch(error => console.error('Error loading more perfumes:', error));
     });
     
     // 收藏按钮的点击事件处理函数
     function handleFavoriteClick() {
         var img = this.querySelector('.heart');
         var perfumeId = this.getAttribute('data-perfume-id');
         var isFavorite = img.getAttribute('src') === '/static/image/start-icon.webp';
     
         if (!isFavorite) {
             img.src = '/static/image/start-icon.webp';
             addFavorite(perfumeId);
         } else {
             img.src = '/static/image/start.webp';
             removeFavorite(perfumeId);
         }
     }
     </script>
     
 <script>   
   $(document).ready(function() {
       $.get('/get-user-info', function(data) {
           if (data.isLoggedIn) {
               // Display the user's name
               $('.subside__barmenu').find('.passwordInput').val(data.user.name);
               // Set the logout button text and functionality
