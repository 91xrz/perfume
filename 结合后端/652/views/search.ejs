<div class="content">
   <% if (query && query.trim() !== "") { %>
      <h1 class="ng-scope">
         "<strong><%= query %></strong>"的搜索结果:
      </h1>
   <% } %>
   
   <div class="searchRes">
      <!-- 香水搜索结果 -->
      <% if (perfumes.length > 0) { %>
      <h1 class="ng-scope" style="font-weight: bold; font-size: 40px; color: #ec9397; text-align: center;">
         香水
      </h1>
   
         <div class="items" id="items" compile="items">
            <% perfumes.slice(0, 5).forEach(function(perfume) { %>
            <div class="item ng-scope">
                <a href="" target="_blank" class="imgborder">
                  <img src="/static/picture/perfume/<%= perfume.id %>.png" class="noxx" onerror="this.onerror=null;this.src='/static/picture/image/六神花露水.webp';">
                </a>
                
                <div class="detail">
                  <a href="/perfumeDetail/<%= perfume.id %>" target="_blank">
                     <h2><%= perfume.perfumeName %></h2>
                 </a>
                  </a>
                  <div class="score-and-stars">
                     <div class="score">
                         <%= perfume.score ? perfume.score + '分' : '暂无' %>
                     </div>
                     <div class="stars">
                        <% 
                          var fullStars = Math.floor(perfume.score / 2); 
                          var halfStar = perfume.score % 2 >= 1.5; 
                          var partialStar = perfume.score % 2 >= 1 && perfume.score % 2 < 1.5; 
                          var starSlots = 5; 
                        %>
                        <% for(var i = 0; i < fullStars; i++) { %>
                           <img src="/static/image/4.png" alt="Star" class="star"> <!-- 满星 -->
                         <% } %>
                         <% if(partialStar) { %>
                           <img src="/static/image/3.png" alt="Star" class="star"> <!-- 1到1.5分的星星 -->
                         <% } %>
                         <% if(halfStar) { %>
                           <img src="/static/image/2.png" alt="Star" class="star"> <!-- 0到1分的星星 -->
                         <% } %>
                         <% for(var i = fullStars + (partialStar ? 1 : 0) + (halfStar ? 1 : 0); i < starSlots; i++) { %>
                           <img src="/static/image/1.png" alt="Star" class="star"> <!-- 空星填充 -->
                         <% } %>
                      </div>
                     </div>
                 
                  <div class="info">
                      <!-- 动态插入前调、中调、后调 -->
                      前调：<%= perfume.qiandiao %>
                      <br>
                      中调：<%= perfume.zhongdiao %>
                      <br>
                      后调：<%= perfume.houdiao %>
                  </div>
              </div>
              <div class="shouchang-button" data-perfume-id="<%= perfume.id %>">
               <img class="heart" src="/static/image/start.webp" style="width: 30px;">
             </div>
            </div>
            <% }); %>
         </div>
        
         <% if (perfumes.length > 5) { %>
            <div id="loadMoreContainer" style="text-align: center; margin-top: 20px;">
               <button id="loadMoreButton" style="padding: 10px 20px; font-size: 16px; cursor: pointer; background-color: #f8a4cd; color: #fff; border: 1px solid #ffbdde; border-radius: 5px; transition: background-color 0.3s;">
                   查看更多
               </button>
           </div>
           
        <% } %>
         <% } %>
      <!-- 品牌搜索结果 -->
      <% if (brands.length > 0) { %>
      <h1 class="ng-scopes" style="font-weight: bold; font-size: 40px; color: #ec9397; text-align: center;">
         品牌
      </h1>
      <% brands.forEach(function(brand) { %>
      <div class="items" style="width: 600px;">
         <div class="item">
            <a href="/brand/brandDetail?name=<%= encodeURIComponent(brand.EnglishName) %>" target="_blank" class="imgborder">
               <img src="/static/image/brand/<%= brand.id %>.png" class="noxx">
            </a>
            <div class="detail" style="padding-top: 14px;">
               <a href="/brand/brandDetail?name=<%= encodeURIComponent(brand.EnglishName) %>" target="_blank">
                  <h2><%= brand.BrandName %></h2>
               </a>
               <div class="info">
                  <%= brand.jianjie.length > 100 ? brand.jianjie.substring(0, 100) + '...' : brand.jianjie %>
              </div>
            </div>
         </div>
      </div>
      <% }); %>
      <% } %>
      <!-- 调香师搜索结果 -->
      <% if (perfumers.length > 0) { %>
      <h1 class="ng-scopes" style="font-weight: bold; font-size: 40px; color: #ec9397; text-align: center;">
         调香师
      </h1>
      <% perfumers.forEach(function(perfumer) { %>
      <div class="items" style="width: 600px;">
         <div class="item">
            <a href="tiaoxiangshi.html" target="_blank" class="imgborder">
               <img src="/static/image/perfumer_placeholder.png" class="noxx">
            </a>
            <div class="detail" style="padding-top: 14px;">
               <a href="tiaoxiangshi.html" target="_blank">
                  <h2><%= perfumer.perfumer1 %></h2>
               </a>
               <div class="info">
                  <%= perfumer.jianjie %> <!-- 假设调香师模型中有生平简介字段 -->
               </div>
            </div>
         </div>
      </div>
      <% }); %>
      <% } %>
   </div>
</div>


