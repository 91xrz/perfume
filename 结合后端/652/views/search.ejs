 <style>.shell{
   position: relative;
   width: 800px;
   padding: 13px;
   background-color: #ec939778;
   border-radius: 25px;
   box-shadow: 0 10px 50px #ec939778,0 0 0 20px #fff;
   height:50px;
 }
 .shell input{
   width:80%;
   height:26px;
   color: #000000;
   font: 300 18px '优设标题黑';
   border:0;
   background-color: transparent;
 }
 .shell input::placeholder{
   color: #00000074;
 }
 .shell a{
   display: flex;
   font-size: 30px;
   position: absolute;
   right: 17px;
   top:0px;
   color: #fff;
   width: 100px;
   height: 26px;
 }
 .shell a .fa{
   margin: 6px 15px;
   transition: .3s;
 }
 .shell a .fa-search{
   transform: translate(-80%);
   opacity: 1;
 }
 .shell a .fa-hand-o-right{
   transform: translate(-100%);
   opacity: 0;
 }
 .shell a:hover .fa-search{
   transform: translate(0);
   opacity: 0;
 }
 .shell a:hover .fa-hand-o-right{
   transform: translate(60px);
   opacity: 1;
 }
 .shell a::before{
   content:'GO!';
   position:absolute;
   display: block;
   font-size: 25px;
   background-color: #ec939778;
   padding: 3px 11px;
   top:-47px;
   right:-25px;
   border-radius: 8px;
   transition: .3s;
   opacity: 0;
   animation: box 1s infinite ease;
 }
 .shell a:hover::before{
   top:-65px;
   opacity: 1;
 }
 @keyframes box{
 0%{
   transform: rotate(0deg);
 }
 33%{
   transform: rotate(8deg);
 }
 66%{
   transform: rotate(-8deg);
 }
 100%{
   transform: rotate(0deg);
 }
 }
 .searchRes { 
 width: 800px;
 }
 .searchRes li{
 margin-top: 3px;
 position: relative;
 }
 @media screen and (min-width:415px) and (max-width: 767px){
 .content .searchRes .ng-scopes{
   margin: 22px 304px 0px 0px;
 }
 }
