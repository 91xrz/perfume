    <style>
        * {
    margin: 0;
    padding: 0;
}
用户代理样式表
div {
    display: block;
}
body {
    overflow-x: hidden;
    color: #444;
    position: relative;
    font-size: 14px;
    font-family: 'PingFang SC','Microsoft Yahei','Source Han Sans',SimSun, 'Noto Sans CJK SC', 'Noto Sans CJK',source-han-sans-simplified-c, sans-serif;
}
:root {
    --swiper-navigation-size: 44px;
}
:root {
    --swiper-theme-color: #007aff;
}
.nose-lists .lists-tit {
    overflow: hidden;
    height: 60px;

}
.nose-lists .lists-tit .lists-cnts {
    color: #6e7099;
    margin-bottom: 15px;
    font-size: 18px;
    float: left;
}
.nose-lists .lists-tit .lists-cnts .lists-tip {
    color: #6e709a;
    line-height: 40px;
    line-height: 40px;
}
ul, li, dl, dd, dt {
    list-style: none;
    margin: 0;
    padding: 0;
}
ul {
    display: block;
    list-style-type: disc;
    margin-block-start: 1em;
    margin-block-end: 1em;
    margin-inline-start: 0px;
    margin-inline-end: 0px;
    padding-inline-start: 40px;
}
.nose-lists .lists li {
    overflow: hidden;
}
.nose-lists .lists li .nose-detail {
    width: 100%;
    float: left;
    border-bottom: 1px solid #eaeaea;
    position: relative;
}
.nose-lists .lists li .nose-detail .nose-avatar {
    height: 110px;
    position: relative;
    width: 66px;
    display: inline-block;
}
.nose-avatar{
    float: left;
}
a {
    text-decoration: none;
    color: #6c6c6c;
    font-size: 14px;
}
.nose-detail .nose-avatar img {
    max-width: 100px;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%,-50%);
    padding-left: 20px;
}
img {
    border: 0;
    border-style: none;
    border-width: 0;
}
* {
    margin: 0;
    padding: 0;
}
用户代理样式表
img {
    overflow-clip-margin: content-box;
    overflow: clip;
}
a {
    text-decoration: none;
    color: #6c6c6c;
    font-size: 14px;
}
用户代理样式表
a:-webkit-any-link {
    color: -webkit-link;
    cursor: pointer;
}
ul, li, dl, dd, dt {
    list-style: none;
    margin: 0;
    padding: 0;
}
用户代理样式表
li {
    text-align: -webkit-match-parent;
}
用户代理样式表
ul {
    list-style-type: disc;
}
.nose-detail .nose-about {
    color: #444;
    font-size: 15px;
    width: 58%;
    height: 110px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    padding: 26px 0px 50px 30px;
    box-sizing: border-box;
}
.nose-about{
    float: left;
}
.nose-detail .nose-about div {
    width: 100%;
}
.nose-detail .nose-about div span {
    cursor: pointer;
}
.nose-detail .nose-about .nose-ename {
    color: #6c6c6c;
}
.nose-detail .operate-it {
    height: 110px;
    width: 15%;
    display: flex;
    justify-content: center;
    align-items: center;
}
.operate-it{
    float: left;
}
.nose-detail .operate-it div {
    cursor: pointer;
    width: 50px;
    height: 50px;
    display: flex;
    display: flex;
    justify-content: center;
    align-items: center;
}
.nose-detail .operate-it .add-icon {
    cursor: pointer;
    background-image: url(//img.xssdcdn.com/static/icon/addnoseicon.svg);
    width: 17px;
    height: 17px;
    display: none;
}
.bg-cover {
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
}
.nose-detail .nose-score {
    display: flex;
    position: absolute;
    right: 0px;
    bottom: 0px;
    top: 0px;
    width: 400px;
    align-items: center;
    height: 110px;
}
.nose-score{
    float: left;
}
.nose-detail .nose-score .nose-star {
    float: right;
    position: relative;
    width: 75px;
}
element.style {
    width: 68.5px;
}
.star0 {
    background-image: url(https://img.xssdcdn.com/static/star.png?1);
    background-repeat: no-repeat;
    /* background-size: 100%; */
    display: inline-block;
    width: 76px;
    height: 15px;
    position: relative;
    top: 3px;
}
.nose-detail .nose-score .nose-star .star0-gray {
    background-position: right;
    position: absolute;
    top: 2px;
    z-index: -1;
    left: 0px;
}
.nose-detail .nose-score .nose-star .nose-value {
    font-size: 15px;
    color: #6c6c6c;
    float: right;
    margin-top: 5px;
}
.sque{
    margin: 0px 0px 0px 120px;
}
@media (max-width: 414px){
    .sque {
    margin: 0px 0px 0px 26px;
}
.nose-detail .nose-score {
    display: none
}
}
@media screen and (min-width:415px) and (max-width: 767px){
    .sque {
    margin: 0px 0px 0px 133px;
}
.nose-detail .nose-score .nose-star {
    width: 213px;
}
.star0 {
    padding-left: 167px;
}
}
@media screen and (min-width:768px) and (max-width: 1199px){
    .sque {
    margin: 0px 0px 0px 163px;
}
.nose-detail .nose-score {
    right:-169px;
}
}
    </style>
