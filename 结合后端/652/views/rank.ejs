<div class="sque">
<div class="nose-lists">
    <div class="lists-tit">
        <div class="lists-cnts">
            <% if (dataType === 'shalong') { %>
                <span class="lists-tip">全部沙龙香水：</span>
            <% } else if (dataType === 'shangye') { %>
                <span class="lists-tip">全部商业香水：</span>
            <% } %>
    </div>
    </div>
    <ul class="lists">
        <% noses.forEach(nose => { %>
            <li class="nose ng-scope">
                <div class="nose-detail">
                    <a class="nose-avatar" href="/<%=dataType%>/<%=nose.id%>">
                        <img src="https://img.xssdcdn.com/perfume/163553.jpg!l"> <!-- 假设这里的图片URL固定 -->
                    </a>
                    <a class="nose-about" href="/<%=dataType%>/<%=nose.id%>">
                        <div class="nose-cname">
                            <!-- 使用EJS标签替换perfumeName -->
                            <span class="ng-binding"><%= nose.perfumeName %></span>
                        </div>
                    </a>
                    <div class="operate-it">
                        <div>
                            <span class="add_icon bg_cover"></span>
                        </div>
                    </div>

                    <div class="nose-score">
                        <div class="nose-star">
                            <!-- 根据score计算星星的宽度 -->
                            <!-- <span class="star0" style="width: <%= (nose.score / 10) * 68.5 %>px;"></span> -->
                            <span class="star0-gray"></span>
                            <br>
                            <!-- 使用EJS标签替换score -->
                            <% if(nose.score > 0){ %>
                                <span class="nose-value ng-binding"><%= nose.score %>分</span>
                            <% } %>
                        </div>
                    </div>
                </div>
            </li>
        <% }) %>
        
       
    </ul>
</div>
