<% perfumes.forEach(function(perfume) { %>
   <div class="items" id="items" compile="items">
      <div class="item ng-scope">
          <a href="/perfumeDetail/<%= perfume.id %>"  target="_blank" class="imgborder">
            <img src="/static/picture/perfume/<%= perfume.id %>.png" class="noxx" onerror="this.onerror=null;this.src='/static/picture/image/六神花露水.webp';">
          </a>
          
          <div class="detail">
            <a href="/perfumeDetail/<%= perfume.id %>" target="_blank">
               <h2><%= perfume.perfumeName %></h2>
           </a>
           
            <div class="score-and-stars">
               <div class="score">
                   <%= perfume.score ? perfume.score + '分' : '暂无' %>
               </div>
               <div class="stars">
                  <% 
                    var fullStars = Math.floor(perfume.score / 2); 
                    var halfStar = perfume.score % 2 >= 1.5; 
                    var partialStar = perfume.score % 2 >= 1 && perfume.score % 2 < 1.5; 
                    var starSlots = 5; 
                  %>
                  <% for(var i = 0; i < fullStars; i++) { %>
                     <img src="/static/image/4.png" alt="Star" class="star"> <!-- 满星 -->
                   <% } %>
                   <% if(partialStar) { %>
                     <img src="/static/image/3.png" alt="Star" class="star"> <!-- 1到1.5分的星星 -->
                   <% } %>
                   <% if(halfStar) { %>
                     <img src="/static/image/2.png" alt="Star" class="star"> <!-- 0到1分的星星 -->
                   <% } %>
                   <% for(var i = fullStars + (partialStar ? 1 : 0) + (halfStar ? 1 : 0); i < starSlots; i++) { %>
                     <img src="/static/image/1.png" alt="Star" class="star"> <!-- 空星填充 -->
                   <% } %>
                </div>
               </div>
            <div class="info">
                <!-- 动态插入前调、中调、后调 -->
                前调：<%= perfume.qiandiao %>
                <br>
                中调：<%= perfume.zhongdiao %>
                <br>
                后调：<%= perfume.houdiao %>
            </div>
        </div>
        <br><br>
        <div class="shouchang-button" data-perfume-id="<%= perfume.id %>">
         <img class="heart" src="/static/image/start.webp" style="width: 30px;">
       </div>
      </div>
     
   </div>
   <% }); %>
</div>
