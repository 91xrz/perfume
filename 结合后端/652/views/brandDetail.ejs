<!DOCTYPE html>
<html lang="en">
<head>
   <!--<< Required meta tags >>-->
   <meta charset="UTF-8">
   <meta http-equiv="X-UA-Compatible" content="IE=edge">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <!--<< Title >>-->
  <title>寻香悦己-品牌</title>
   <!--<< Favcion >>-->
   
   <!--<< Bootstrap min.css >>-->
   <link rel="stylesheet" href="/static/css/bootstrap.min.css">
   <!--<< Aos animation css >>-->
   <link rel="stylesheet" href="/static/css/aos.css">
   <!--<< Main.css >>-->
   <link rel="stylesheet" href="/static/css/main.css">
   <link rel="stylesheet" href="/static/css/xiangdiao.css">
</head>
<body>

<!--<< Preloader >>-->
<%- include('./partials/header') %>
   <!--<< Header v-1 >>-->
   <div class="container pt-120 pb-120">
      <div class="row g-4 justify-content-center">
         <div class="col-lg-8">
            <div class="breadcrumnd__wrap text-center">
               <h1>
                  品牌
               </h1>
               <ul class="breakcrumnd__cont justify-content-center">
                  <li>
                     <a href="/index.html">
                        Home 
                     </a>
                  </li>
                  <li class="white">
                     /  
                  </li>
                  <li class="base">
                     brands
                  </li>
               </ul>
            </div>
         </div>
      </div>
   </div>
</section>
<div class="content ng-scop" ng-controller="NtLiKeCtrl">
    <div>
        <img src="/static/image/brand/<%= brandDetails.id %>.png" style="width:1000px;height:300px;margin:0 8%;" onerror='imgcdnfallback(this,"/static/image/果香调.webp")'>
        <div class='covertxt'><%= brandDetails.BrandName %></div>
        <div class='fragrance clearfloat'>
     </div>
     <div class="desc">
         <p class="x"><%= brandDetails.BrandName %></p>
         <p class="x"><%= brandDetails.jianjie %></p>
     </div>
     <div style="font-size:18px;color:rgb(80, 122, 174)">该品牌香水推荐：</div>
     <div style="height:10px;margin:0;position:relative;clear:both;border-bottom: 3px solid #eee;"></div>
     <div class="items" id="items" compile="items">
      <% if (perfumes && perfumes.length > 0) { %>
         <% perfumes.forEach(function(perfume) { %>
             <div class="item ng-scope">
                 <a href="/perfumeDetail/<%= perfume.id %>" target="_blank" class="imgborder">
                  <img src="/static/picture/perfume/<%= perfume.id %>.png" class="noxx" onerror="this.onerror=null;this.src='/static/picture/image/六神花露水.webp';">
                 </a>
                 <div class="detail">
                  <a href="/perfumeDetail/<%= perfume.id %>" target="_blank">
                     <h2><%= perfume.perfumeName %></h2>
                 </a>
                 <div class="score-and-stars">
                  <div class="score">
                      <%= perfume.score ? perfume.score + '分' : '暂无' %>
                  </div>
                  <div class="stars">
                     <% 
                       var fullStars = Math.floor(perfume.score / 2); 
                       var halfStar = perfume.score % 2 >= 1.5; 
                       var partialStar = perfume.score % 2 >= 1 && perfume.score % 2 < 1.5; 
                       var starSlots = 5; 
                     %>
                     <% for(var i = 0; i < fullStars; i++) { %>
                        <img src="/static/image/4.png" alt="Star" class="star"> <!-- 满星 -->
                      <% } %>
                      <% if(partialStar) { %>
                        <img src="/static/image/3.png" alt="Star" class="star"> <!-- 1到1.5分的星星 -->
                      <% } %>
                      <% if(halfStar) { %>
                        <img src="/static/image/2.png" alt="Star" class="star"> <!-- 0到1分的星星 -->
                      <% } %>
                      <% for(var i = fullStars + (partialStar ? 1 : 0) + (halfStar ? 1 : 0); i < starSlots; i++) { %>
                        <img src="/static/image/1.png" alt="Star" class="star"> <!-- 空星填充 -->
                      <% } %>
                   </div>
                  </div>
                     <div class="info">
                         前调：<%=perfume.qiandiao %>
                         <br>
                         中调：<%=perfume.zhongdiao %>
                         <br>
                         后调：<%=perfume.houdiao %>
                     </div>
                 </div>
                 <div class="shouchang-button">
                  <img class="heart" src="/static/image/start.webp" style="width: 30px;"></img>
                </div>
             </div>
         <% }); %>
     <% } else { %>
         <p>No perfumes found for this perfumer.</p>
     <% } %>
    </div>
</div>
<!--<<  sub side bar custom >>-->

</div>
</div>
<!--<<  sub side bar custom >>-->
<div class="containerr pt-120 pb-120">
   <div class="row g-4 justify-content-center">
      <div class="col-lg-8">
         <div class="breadcrumnd__wrap text-center">
            <h1>
               人生海海，有幸相遇！
            </h1>
            <ul class="breakcrumnd__cont justify-content-center">
               <li>
                  <a href="index.html">
                     Home 
                  </a>
               </li>
               <li class="white">
                  /  
               </li>
               <li class="base">
                  <a href="contact.html">
                  Join Us
                  </a>
               </li>
            </ul>
         </div>
      </div>
   </div>
</div>
<div class="subside__barmenu sub__contact">
   <div class="remove__click d-flex justify-content-center align-items-center">
      <i class="bi bi-x-lg"></i>
   </div>
   <div>
      <img src="static/picture/logo.png" alt="img" style="height: 50px;width: 100px;">
   </div>
   <div class="sub__contact__wrapper d-grid">
  
      <a href="index.html" class="side-logo">
         <img src="/static/picture/头像.webp" alt="img" class="side-logo1">
      </a>
      <ul>
         <li>
            昵称：<input type="text" class="passwordInput" readonly>
         </li>
      </ul>
   </div>
   <a href="index.html" class="d-flex justify-content-center fw-500 cmn--btn align-items-center gap-2 logout-button">
         <span>
            <i class="bi bi-chevron-right"></i>             
         </span>
         <span class="get__text">
            退出登录
         </span>
      </a>
      <a href="index.html" class="d-flex justify-content-center fw-500 cmn--btn align-items-center gap-2">
         <span>
            <i class="bi bi-chevron-right"></i>             
         </span>
         <span class="get__text">
            进入首页
         </span>
      </a>
</div>  

<div class="progress-wrap">
    <svg class="progress-circle svg-content" width="100%" height="100%" viewbox="-1 -1 102 102">
       <path fill="#c9f31d" d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98"></path>
    </svg>
    <i class="bi bi-arrow-90deg-up title topping"></i>
 </div>
 <!--<< Scroll To Top >>-->
 <%- include('./partials/jss') %>

 <!--<< Main.js >>-->
</body>
</html>